# ============================================
# SmartNotes Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
# ============================================

# ============================================
# REQUIRED - Groq API Configuration
# ============================================
# Get your API key from: https://console.groq.com/keys
# Models available: llama-3.1-8b-instant, mixtral-8x7b-32768, etc.
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# REQUIRED - MongoDB Configuration
# ============================================
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017
#
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/notesDB?retryWrites=true&w=majority
#
# Replace username, password, and cluster-name with your Atlas credentials
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=notesDB

# ============================================
# OPTIONAL - Application Configuration
# ============================================
# Environment mode: development, staging, production
ENVIRONMENT=development

# Enable debug mode (verbose logging)
DEBUG=True

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# OPTIONAL - CORS Configuration
# ============================================
# Allowed origins for frontend requests (comma-separated)
# Examples: http://localhost:5173,https://yourdomain.com
# Default: * (allows all origins - not recommended for production)
ALLOWED_ORIGINS=*

# ============================================
# OPTIONAL - File Upload Configuration
# ============================================
# Maximum file upload size in MB
MAX_FILE_SIZE_MB=500

# Supported file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,mp3,wav,mp4,avi,mov,mkv,webm,m4a,ogg,flac,aac

# ============================================
# OPTIONAL - LLM Model Configuration
# ============================================
# Groq model to use for summarization and chat
LLM_MODEL=llama-3.1-8b-instant

# Max tokens for model responses
MAX_TOKENS=1000

# Temperature for model responses (0.0 - 2.0, lower = more deterministic)
TEMPERATURE=0.7

# ============================================
# OPTIONAL - Embedding Configuration
# ============================================
# HuggingFace model for embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunk size for text splitting (tokens)
CHUNK_SIZE=800

# Chunk overlap (tokens)
CHUNK_OVERLAP=150

# ============================================
# OPTIONAL - FAISS Vector Store Configuration
# ============================================
# Path to store FAISS indexes
FAISS_INDEX_PATH=database/vectorstore/index.faiss

# ============================================
# OPTIONAL - API Server Configuration
# ============================================
# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Enable/disable API docs (Swagger UI and ReDoc)
ENABLE_API_DOCS=True

# ============================================
# OPTIONAL - GPU Configuration
# ============================================
# Use GPU if available (requires CUDA)
USE_GPU=True

# Specific CUDA device to use (0, 1, 2, etc. or 'auto')
CUDA_DEVICE=auto

# ============================================
# OPTIONAL - Caching Configuration
# ============================================
# Enable response caching
ENABLE_CACHE=True

# Cache TTL in seconds
CACHE_TTL=3600

# ============================================
# OPTIONAL - Rate Limiting
# ============================================
# Maximum requests per minute per IP
RATE_LIMIT_RPM=100

# ============================================
# OPTIONAL - Logging Configuration
# ============================================
# Log requests
LOG_REQUESTS=True

# Log database queries
LOG_DB_QUERIES=False

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to git - use .env.example instead
# 2. For production, use environment variables instead of .env file
# 3. Keep sensitive keys (API keys, passwords) secure
# 4. Use strong, unique values for production
# 5. Update this file when new configuration options are added
# ============================================
